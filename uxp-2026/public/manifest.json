{
  "id": "com.xiali.premiere.reviewexport.uxp",
  "name": "Marker Review Export",
  "shortname": "ReviewExport",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.3.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "id": "reviewExportPanel",
      "type": "panel",
      "minimumSize": { "width": 360, "height": 420 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 420, "height": 650 },
      "preferredFloatingSize": { "width": 460, "height": 720 },
      "label": { "default": "Marker Review Export" },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel-dark.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/panel-light.svg", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.svg", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
