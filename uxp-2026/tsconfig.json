{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "types": ["node", "@adobe/cc-ext-uxp-types"],
    "skipLibCheck": true
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.js", "test/**/*.ts"]
}
